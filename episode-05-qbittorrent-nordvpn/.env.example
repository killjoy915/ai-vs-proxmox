# qBittorrent + NordVPN example environment file

# NordVPN service credentials
# Do NOT use your normal NordVPN account password here.
# Use NordVPN service credentials intended for manual OpenVPN connections.

OPENVPN_USER=YOUR_NORDVPN_SERVICE_USERNAME
OPENVPN_PASSWORD=YOUR_NORDVPN_SERVICE_PASSWORD

# Linux user/group IDs used by the qBittorrent container
PUID=1000
PGID=1000

# Time zone
TZ=America/Phoenix
